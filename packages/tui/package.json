{
  "name": "@engineering-process/tui",
  "version": "0.1.0",
  "description": "Terminal UI for the engineering-process Claude Code plugin",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ep-tui": "./bin/ep-tui.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "execa": "^8.0.1",
    "ink": "^5.0.1",
    "meow": "^13.2.0",
    "react": "^18.3.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@vitest/coverage-v8": "^1.6.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "files": [
    "dist",
    "bin"
  ],
  "keywords": [
    "cli",
    "tui",
    "ink",
    "react",
    "terminal",
    "engineering-process",
    "claude"
  ],
  "license": "MIT"
}
