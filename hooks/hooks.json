{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/phase-gate.sh\" pre-write",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-phase-transition.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/post-write.sh\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/quick-verification.sh\"",
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "implementer",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/on-implementer-stop.sh\"",
            "timeout": 300
          }
        ]
      },
      {
        "matcher": "validator",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/on-validator-stop.sh\"",
            "timeout": 600
          }
        ]
      },
      {
        "matcher": "requirements-verifier",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/on-requirements-verified.sh\"",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "adversary",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/on-adversary-complete.sh\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/completion-check.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "_comment": "Enforced verification hooks - ensures verification runs automatically",
  "_enforcement_summary": {
    "PreToolUse": "Blocks writes until phase preconditions met AND phase transition is valid (including formal verification)",
    "PostToolUse": "Runs quick verification (typecheck, lint, quick tests) after every edit",
    "SubagentStop:implementer": "Runs full validation (tests/lint) when implementer finishes",
    "SubagentStop:validator": "Runs mutation tests + fuzzing when validator finishes",
    "SubagentStop:requirements-verifier": "Enforces requirements completeness check",
    "SubagentStop:adversary": "Validates adversarial testing completeness (3+ cases required)",
    "Stop": "Blocks incomplete phases from exiting"
  }
}
